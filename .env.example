# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# --- n8n ---
# Même valeur que le credential n8n « Header Auth » nommé « Rebuy Webhook Secret » (en-tête X-Secret)
N8N_WEBHOOK_SECRET=change-me
# URL publique de n8n (optionnel, sert aux adresses de webhook affichées) : http://IP:PORT/
N8N_PUBLIC_URL=
# --- Génération des workflows (node --env-file=.env n8n/workflows.mjs <nom>) ---
# IDs de TON instance n8n (Data Tables, credentials) ; pas des secrets, mais propres à chaque installation.
N8N_TABLE_PRODUITS=
N8N_TABLE_HISTORIQUE=
N8N_DISCORD_CRED_ID=
# Optionnel : ID du credential Header Auth existant (sinon n8n propose de le créer)
# N8N_SECRET_CRED_ID=

# Optionnels (calculés automatiquement par start.js) :
# N8N_WEBHOOK_BASE=http://localhost:PORT/webhook
# GENERIC_TIMEZONE=Europe/Paris
